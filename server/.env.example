# Copy this file to server/.env and adjust values for your environment.
# SQLite by default — the file is created inside server/prisma/.
DATABASE_URL="file:./dev.db"

# Server
PORT=4000
NODE_ENV=development

# Allowed browser origin for CORS in development
CLIENT_ORIGIN="http://localhost:5173"

# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Set to "true" when serving over HTTPS in production
COOKIE_SECURE=false
