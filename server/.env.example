# Copy this file to server/.env and adjust values for your environment.
# Never commit server/.env.

# SQLite by default — the file is created inside server/prisma/.
# For a managed production database, switch the Prisma provider and use its URL.
DATABASE_URL="file:./dev.db"

# Server binding
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Browser origins allowed to call the API (comma-separated).
# Development:
CLIENT_ORIGIN="http://localhost:5173"
# Production example:
# CLIENT_ORIGIN="https://scholaris.example.com"

# Set to true only for local production smoke tests that use localhost.
# ALLOW_LOCALHOST_ORIGIN=false

# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Set to "true" when serving over HTTPS in production.
# The server also forces secure cookies automatically when NODE_ENV=production.
COOKIE_SECURE=false

# Initial administrator. Run `npm run db:bootstrap-admin` to create or safely
# upgrade this account. If ADMIN_PASSWORD is omitted for a brand-new account,
# a random password is generated into server/.admin-credentials (mode 600).
ADMIN_NAME="Mahesh Kumar"
ADMIN_EMAIL="admin@scholaris.edu"
# ADMIN_PASSWORD="replace-with-a-strong-password"
