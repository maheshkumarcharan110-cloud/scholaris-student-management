// Scholaris — Student Management System
// Prisma schema (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(TEACHER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher           Teacher?
  attendanceRecords Attendance[] @relation("RecordedBy")
}

model Teacher {
  id            String   @id @default(cuid())
  employeeNo    String   @unique
  phone         String?
  qualification String?
  userId        String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes     Class[]  @relation("ClassTeacher")
  subjects    Subject[]
  marks       Mark[]   @relation("RecordedBy")
}

model Class {
  id             String   @id @default(cuid())
  name           String
  section        String
  academicYear   String
  room           String?
  classTeacherId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classTeacher Teacher?  @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  students     Student[]
  subjects     Subject[]
  exams        Exam[]

  @@unique([name, section, academicYear])
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String
  classId   String
  teacherId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class       Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher     Teacher?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  examSubjects ExamSubject[]
  marks       Mark[]

  @@unique([code, classId])
}

model Student {
  id            String        @id @default(cuid())
  admissionNo   String        @unique
  firstName     String
  lastName      String
  gender        String
  dateOfBirth   DateTime?
  email         String?
  phone         String?
  guardianName  String
  guardianPhone String
  address       String?
  status        StudentStatus @default(ACTIVE)
  enrolledAt    DateTime      @default(now())
  classId       String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  class      Class        @relation(fields: [classId], references: [id], onDelete: Restrict)
  attendance Attendance[]
  marks      Mark[]

  @@index([classId])
}

model Attendance {
  id           String           @id @default(cuid())
  studentId    String
  date         DateTime
  status       AttendanceStatus
  note         String?
  recordedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("RecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([date])
}

model Exam {
  id        String     @id @default(cuid())
  name      String
  term      String
  classId   String
  startDate DateTime
  endDate   DateTime
  status    ExamStatus @default(DRAFT)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  class    Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjects ExamSubject[]
  marks    Mark[]

  @@unique([name, term, classId])
}

model ExamSubject {
  id        String    @id @default(cuid())
  examId    String
  subjectId String
  maxMarks  Int       @default(100)
  examDate  DateTime?

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, subjectId])
}

model Mark {
  id           String   @id @default(cuid())
  examId       String
  subjectId    String
  studentId    String
  marks        Float
  recordedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation("RecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([examId, subjectId, studentId])
  @@index([studentId])
}
