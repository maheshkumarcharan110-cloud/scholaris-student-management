# Leave blank in development to use Vite's same-origin /api proxy.
# In production, set this only when the API is hosted on a different origin,
# for example: VITE_API_URL="https://scholaris-api.example.com/api"
VITE_API_URL=

# Show the seeded teacher shortcut on the login page. Administrator passwords
# are never shipped to the browser. Defaults to development-only when unset.
VITE_SHOW_DEMO_ACCOUNTS=false
